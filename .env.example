# Laravel
APP_NAME="LED Display Server"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=https://led.example.com

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Derrière Caddy : faire confiance aux proxies (TrustProxies)
TRUSTED_PROXIES=*

# PostgreSQL (défaut Docker)
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=led_display
DB_USERNAME=led
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Ne pas mettre SESSION_DOMAIN=null (devient la string "null" et casse les cookies).
# Laisser vide / absent, ou SESSION_DOMAIN=command.lha.run si besoin.
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=led_display_

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@led-display.local"
MAIL_FROM_NAME="${APP_NAME}"

# Auth
AUTH_GUARD=web
AUTH_PASSWORD_BROKER=users

# Passport (clés générées via php artisan passport:keys)
# En prod Docker, préférer des secrets injectés :
# PASSPORT_PRIVATE_KEY=
# PASSPORT_PUBLIC_KEY=

# MQTT — broker Mosquitto (service docker "mqtt" ou broker externe)
# Les Pi joignent le broker directement (port hôte), pas via Caddy HTTP.
MQTT_HOST=mqtt
MQTT_PORT=1883
MQTT_PUBLIC_PORT=1883
MQTT_TLS_PUBLIC_PORT=8883
MQTT_TLS_ENABLED=false
MQTT_TLS_ALLOW_SELF_SIGNED_CERT=false
MQTT_TLS_VERIFY_PEER=true
MQTT_TLS_VERIFY_PEER_NAME=true
MQTT_AUTH_USERNAME=ledserver
MQTT_AUTH_PASSWORD=changeme
MQTT_CLIENT_ID=led-display-server
MQTT_KEEP_ALIVE_INTERVAL=10
MQTT_CONNECT_TIMEOUT=30
MQTT_SOCKET_TIMEOUT=5

# MQTTS : générer les certs puis ouvrir le firewall 8883
#   ./docker/mosquitto/generate-certs.sh command.lha.run
# Clients externes (Tasmota/Pi) : port 8883 + TLS.
# Laravel dans Docker reste en clair vers mqtt:1883 (ci-dessus).
#
# Si Laravel doit parler en TLS au broker :
# MQTT_HOST=command.lha.run
# MQTT_PORT=8883
# MQTT_TLS_ENABLED=true
# MQTT_TLS_CA_FILE=/etc/ssl/certs/ca-certificates.crt
# MQTT_TLS_ALLOW_SELF_SIGNED_CERT=true

VITE_APP_NAME="${APP_NAME}"
