# À fusionner dans le Caddyfile du reverse-proxy VPS.
# Prérequis : réseau Docker externe "proxy" + conteneur led-display-web dessus.
#
#   docker network create proxy   # une seule fois
#
# Caddy doit être sur le même réseau `proxy` (voir son docker-compose).
#
# Les header_up X-Forwarded-* sont OBLIGATOIRES pour Laravel (cookies Secure,
# CSRF / Filament Livewire). Sans eux → 419 « This page has expired ».

command.lha.run {
	encode gzip

	reverse_proxy led-display-web:80 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Real-IP {remote_host}

		transport http {
			read_timeout 120s
			write_timeout 120s
		}
	}
}
